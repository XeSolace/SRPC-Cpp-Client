            socket,
            "magicboot title=\"Hdd:\\Games\\default.xex\" "
            "directory=\"Hdd:\\Games\"");
        // A title switch intentionally has no reply.
    });

    {
        srpc::Client client("127.0.0.1", test_options(server.port()));
        client.connect();
